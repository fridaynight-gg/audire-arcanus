{
  "name": "audire-arcanus",
  "version": "0.2.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "check": "bun run typecheck && bun run lint && bun run format:check",
    "typecheck": "tsc -b",
    "lint": "oxlint -c oxlint.config.mjs .",
    "lint:plugins": "bun build tools/oxlint/anti-slop/index.ts --outfile tools/oxlint/anti-slop.bundle.mjs --target=node --format=esm && bun build tools/oxlint/anti-slop/effect/index.ts --outfile tools/oxlint/anti-slop-effect.bundle.mjs --target=node --format=esm",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "dev": "bun run --filter @audire/host start",
    "serve": "bun run --filter @audire/cli start",
    "prepare": "effect-tsgo patch || true"
  },
  "devDependencies": {
    "@effect/tsgo": "0.48.0",
    "@effect/vitest": "4.0.0",
    "@oxlint/plugins": "1.86.0",
    "@types/bun": "1.4.2",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "packageManager": "bun@1.4.2",
  "dependencies": {
    "@effect/platform-bun": "4.0.0",
    "effect": "4.0.0"
  }
}
