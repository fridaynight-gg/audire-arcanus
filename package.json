{
  "name": "audire-arcanus",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": ">=1.3.0"
  },
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "check": "bun run typecheck && bun run lint && bun run format:check",
    "typecheck": "tsc -b",
    "lint": "oxlint .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "dev": "bun run --filter @audire/host start",
    "serve": "bun run --filter @audire/cli start",
    "prepare": "effect-tsgo patch || true"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "typescript": "7.0.2"
  }
}
